<div class="container py-4">

  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-4">
  <link rel="stylesheet" href="/stylesheets/history.css">

    <h4 class="fw-bold history-title">
      📜 Lịch sử ghi nợ
    </h4>

    <a href="/borrow/export" class="btn btn-success export-btn">
      📥 Xuất Excel
    </a>

  </div>

  <!-- STATS -->
  <div class="card shadow-sm border-0 mb-4 dark-card">

    <div class="card-body d-flex gap-4">

      <div>
        💸 Chưa trả:
        <span class="text-danger fw-bold">
          <%= borrows.filter(b => b.status === 'pending').length %>
        </span>
      </div>

      <div>
        ✅ Đã trả:
        <span class="text-success fw-bold">
          <%= borrows.filter(b => b.status === 'paid').length %>
        </span>
      </div>

    </div>

  </div>

  <!-- FORM -->
  <div class="card shadow-sm border-0 mb-4 dark-card">

    <div class="card-body">

      <form
        action="/borrow/create"
        method="POST"
        class="row g-2"
      >

        <div class="col-md-4">
          <input
            name="name"
            class="form-control dark-input"
            placeholder="Tên người nợ"
            required
          >
        </div>

        <div class="col-md-3">
          <input
            name="amount"
            type="number"
            class="form-control dark-input"
            placeholder="Số tiền"
            required
          >
        </div>

        <div class="col-md-3">
          <input
            name="note"
            class="form-control dark-input"
            placeholder="Ghi chú"
          >
        </div>

        <div class="col-md-2 d-grid">

          <button class="btn add-btn">
            ➕ Thêm
          </button>

        </div>

      </form>

    </div>

  </div>

  <!-- TABLE -->
  <div class="card shadow-sm border-0 dark-card">

    <div class="card-body p-0">

      <table class="table table-hover align-middle mb-0 dark-table">

        <thead>

          <tr>
            <th>Người nợ</th>
            <th>Số tiền</th>
            <th>Ghi chú</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
          </tr>

        </thead>

        <tbody>

          <% borrows.forEach(b => { %>

            <tr>

              <td class="fw-semibold text-light">
  <%= b.person || b.name %>
</td>

              <td class="money-text">
                <%= Number(b.amount).toLocaleString() %> đ
              </td>

              <td class="text-light">
                <%= b.note || '-' %>
              </td>

              <!-- STATUS -->
              <td>

                <% if(b.status === "pending"){ %>

                  <a
                    href="/borrow/toggle/<%= b._id %>"
                    class="status-btn pending"
                  >
                    Chưa trả
                  </a>

                <% } else { %>

                  <a
                    href="/borrow/toggle/<%= b._id %>"
                    class="status-btn done"
                  >
                    Đã trả
                  </a>

                <% } %>

              </td>

              <!-- ACTION -->
              <td>

                <a
                  href="/borrow/delete/<%= b._id %>"
                  class="btn btn-sm delete-btn"
                  onclick="return confirm('Xóa khoản này?')"
                >
                  🗑
                </a>

              </td>

            </tr>

          <% }) %>

        </tbody>

      </table>

      <% if (borrows.length === 0) { %>

        <div class="empty-box">
          Chưa có khoản nợ nào
        </div>

      <% } %>

    </div>

  </div>

</div>